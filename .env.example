# Secrets never belong in git — copy this file to .env (or export the vars
# in your MCP client config) and paste your real key there.
# .env is git-ignored.

# Your free Companies House API key.
# Signup (2 minutes, no card): https://developer.company-information.service.gov.uk/signin
#   1. Register a Companies House account (email + password).
#   2. Sign in, choose "Applications", create a new application.
#   3. Copy the API key shown and paste it below.
CH_API_KEY=your_companies_house_api_key_here

# Optional: point at a Companies-House-compatible endpoint instead of the
# real one (used by this repo's own tests). Leave unset for normal use.
# CH_BASE_URL=https://api.company-information.service.gov.uk